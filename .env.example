# Public HTTPS address of this gateway (no trailing slash).
PUBLIC_URL=https://t3code-linear-gateway.example.com

# From your Linear OAuth app (Settings → API → OAuth applications).
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=

# T3 Code hosts as name=mcp-url pairs, comma-separated.
# Each URL is the host's MCP URL (Settings → Environments → Copy MCP URL).
# Use the HTTPS address (T3 Connect or Tailscale): T3 sign-in does not work over plain HTTP.
T3_HOSTS=t3-01=https://<t3-01-address>/mcp,t3-02=https://<t3-02-address>/mcp

# Optional: the label group that names an issue's repository (default: Repo).
# REPO_LABEL_GROUP=Repo

# Optional: branch new worktrees start from (default: T3's default).
# T3_BASE_BRANCH=main
